# OnlyOffice 可选集成配置模板
# 复制为 .env（已被 .gitignore 忽略）并填入真实值，然后执行：
#   docker compose up -d --build
# （office 服务默认随 compose 一起启动；只想跑主应用时用 docker compose up -d cloudirve）

# 总开关：1 = 启用在线编辑（同时开启 Document Server 的 JWT 校验）
OFFICE_ENABLED=1

# 两端共享的 JWT 密钥：Cloudirve 与 Document Server 必须一致
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OFFICE_JWT_SECRET=

# 浏览器可访问的 Document Server 地址（用于加载编辑器 SDK）
# 局域网示例：http://192.168.1.10:8080；反代示例：https://office.example.com
OFFICE_PUBLIC_URL=http://127.0.0.1:8080

# Document Server 容器访问 Cloudirve 的地址（用于拉取文件和保存回调）
# 同一 compose 网络内保持默认即可；跨主机部署时改为 DS 容器可达的地址
OFFICE_CALLBACK_ORIGIN=http://cloudirve:4173

# Cloudirve 容器访问 Document Server 的内部地址（保持默认即可）
OFFICE_URL=http://office
